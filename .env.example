# LLM provider
# Options: mock | openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI (optional alternative)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure credentials — two options:
# Option A (local dev): fill AZURE_CLIENT_ID + AZURE_CLIENT_SECRET + AZURE_TENANT_ID
# Option B (Azure Container Apps): leave blank — Managed Identity handles auth automatically
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=  # Only needed for local dev. Not used in Azure Container Apps.

# Database
DATABASE_URL=sqlite+aiosqlite:///./workflow_platform.db
CHECKPOINT_DB_URL=./checkpoints.db

# Langfuse tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# API server
API_HOST=0.0.0.0
API_PORT=8010
